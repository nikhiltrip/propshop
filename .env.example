# Export these variables in your shell before starting the API.
PROPSHOP_HEADED=1
PROPSHOP_SPORTS=NBA,NFL,MLB,NHL
# PYTHON=/absolute/path/to/.venv/bin/python
PORT=3001

# public = free ScoresAndOdds comparison feed; browser = direct experimental adapters
PROPSHOP_SOURCE=public
# Optional dedicated profile for --source browser (contains private login cookies)
# PROPSHOP_PROFILE_DIR=/absolute/path/to/private-profile
